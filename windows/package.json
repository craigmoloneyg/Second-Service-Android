{
  "name": "garnish-windows",
  "version": "1.1.0",
  "description": "Garnish desktop app",
  "private": true,
  "main": "main.js",
  "author": "Garnish",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "38.1.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.secondservice.price2plate",
    "productName": "Garnish",
    "artifactName": "Garnish-Setup-${version}.${ext}",
    "directories": { "output": "dist" },
    "extraResources": [{"from":"../app/src/main/assets", "to":"enhancements", "filter":["welcome.js", "invoice-batch.js"]}],
    "files": ["main.js", "preload.js", "logo.svg"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Garnish-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Garnish"
    }
  }
}
